# syncmill.toml — project configuration baseline.
#
# Copy to `syncmill.toml` in the directory you run syncmill from. Every field is
# optional; what you omit falls back to defaults. `SYNCMILL_*` environment vars
# override anything set here (env > file > defaults), and the CLI flags
# --repo / --strategy / --timeout override both.
#
# Discovery is cwd-relative: syncmill reads `syncmill.toml` from the current
# working directory, not from --repo / repo_root (which this file can itself set).

# Agent fallback / stage / winner-priority order.
agent_priority = ["claude", "codex", "kimi-code"]

# One of: route (default), pipeline, compete, council, decompose.
default_strategy = "route"

# Default target repo (relative or absolute). Overridden by `--repo`.
repo_root = "."

# Long-term memory backend. memtomem is the default; mem0 is an optional P3
# reference backend installed with `uv sync --extra mem0`.
[memory]
backend = "memtomem"
db_path = "~/.memtomem/memtomem.db"

# To use mem0 instead, set backend = "mem0" above. The default is local Qdrant
# plus multilingual FastEmbed (384 dimensions); first use downloads model assets.
# Local Qdrant holds an exclusive path lock, so use the remote-server example
# below when multiple syncmill processes need the backend concurrently.
# Mem0 telemetry is disabled unless explicitly enabled here. Mem0 reads the value
# on the process's first import; restart the process after changing it.
# [memory.mem0]
# data_dir = "~/.syncmill/mem0"
# telemetry = false
#
# Arbitrary mem0 component overrides are passed through under `config`. P3
# deliberately supports Qdrant only so shared_stats and scratch GC stay exact.
# [memory.mem0.config.vector_store]
# provider = "qdrant"
# [memory.mem0.config.vector_store.config]
# url = "http://localhost:6333"       # remote server; removes the local Qdrant path
# collection_name = "syncmill"
# embedding_model_dims = 384

# Per-agent settings. The table name is the agent's CONFIG FIELD name, so the
# hyphenated `kimi-code` agent is the underscored [kimi_code] table (matching the
# SYNCMILL_KIMI_CODE__ env prefix). max_turns is only honored by claude.
[claude]
enabled = true
timeout_seconds = 300
max_turns = 10

[codex]
enabled = true
timeout_seconds = 300

[kimi_code]
enabled = true
timeout_seconds = 300

# Quality gates (#10): commands run against an agent's worktree after it finishes;
# the result is accepted only if every command exits 0. Empty list = disabled.
[gate]
commands = []
timeout_seconds = 300

# Circuit breaker (#8): reactive back-off from repeatedly-failing agents.
# Disabled by default; state persists across runs to state_path.
[breaker]
enabled = false
failure_threshold = 3
cooldown_seconds = 300
state_path = "~/.syncmill/breaker.json"

# Council strategy (#13): used only when default_strategy = "council". `rounds`
# is the number of critique rounds between propose and synthesize (>=1), so the
# total phases per council = 1 propose + rounds critique + 1 synthesize.
[council]
rounds = 1

# Decompose strategy (#14): used only when default_strategy = "decompose".
# `max_subtasks` caps how many subtasks the planner may produce (>=1); the
# breakdown is truncated to this many.
[decompose]
max_subtasks = 8

# Capability matching (#9): re-order agents by declared capability for a task
# that carries a matching `--capability/-c` hint. Keyed by the REAL agent id, so
# `kimi-code` keeps its hyphen here (unlike the [kimi_code] table above).
# Empty = disabled (ordering stays at agent_priority).
[capabilities.agents]
# codex = ["python", "refactor"]
# kimi-code = ["rust"]

# Persistent work-board (Phase 1): durable, structured records of team work —
# `syncmill board add/list/show/run/update`. Disabled by default. When enabled
# the SQLite store is LOAD-BEARING (a corrupt db is a hard error, not a silent
# degrade), but it's built lazily, so even an enabled-but-broken board never
# affects a plain `syncmill run`. `lease_timeout_seconds` bounds how long a
# claimed item may sit before stale-claim recovery returns it to `planned`.
[board]
enabled = false
db_path = "~/.syncmill/board.db"
lease_timeout_seconds = 1800

# Run reports (S3, ecosystem integration): when enabled, every run writes a
# schema-versioned join artifact to {runs_dir}/{run_id}/envelope.json (plus a
# result.json copy) per contracts/run-envelope.schema.json — digests and counts
# only, never prompts/output/patch bodies. Best-effort: a report failure warns
# and the run continues. Disabled by default (no filesystem touch). Inspect
# with `syncmill report list` / `report show <run_id>` (read-only, work even
# while disabled). `keep_last` bounds the retention sweep at run start — the
# oldest run directories beyond this many are removed (the current run always
# survives and counts toward the total).
[integration.report]
enabled = false
runs_dir = "~/.syncmill/runs"
keep_last = 50

# Trace export (S3′, ecosystem integration): when enabled, each run (route +
# compete instrumented in v1) buffers spans and atomically writes an OTLP
# protobuf-JSON document to {dir}/{run_id}/trace.otlp.json — ingestable by
# tracegraph as-is (`tracegraph ingest-otlp`). Spans are body-free by contract
# (stable structural names, syncmill.* allowlist attributes; never prompts,
# output, patch bodies, or file paths). Best-effort: an exporter failure warns
# and the run continues. `dir = ""` means "the report runs_dir" so the trace
# lands beside the run envelope; "otlp-http" is reserved (warns, falls back to
# file); `include_output` is accepted but warn+ignored in v1.
[integration.trace]
enabled = false
exporter = "file"
dir = ""
include_output = false

# Toolgraph preflight (S5/P3.1). Advisory mode preserves the lead-agent,
# fail-open behavior. Strict mode evaluates every participating mapped identity
# before dispatch and enforces the selected profile. Strict requires report
# recording, non-empty qualified candidates, and an agent map. Unknown identity
# or tool and Toolgraph unavailability block by default; drift warns by default.
# Returned malformed/mismatched evidence always blocks. Toolgraph itself remains
# an advisory producer; SyncMill owns the enforcement decision.
[integration.toolgraph]
enabled = false
mode = "advisory"
profile = "review"
unknown_policy = "block"
drift_policy = "warn"
unavailable_policy = "block"
timeout_seconds = 5
# command = ["toolgraph", "preflight"]
# candidate_tools = ["memtomem::mem_search", "syncmill::shared_read"]
# [integration.toolgraph.agent_map]
# codex = "codex"
# "kimi-code" = "kimi"

# Named team profiles (Phase 4): a savable agent subset + capability/strategy
# bundle, selected per run with `run --team <name>` / `board run --team <name>`,
# or automatically by `board run --goal <g>` when a profile declares that goal.
# The [teams.<name>] table name is the VERBATIM team name (hyphens kept, like
# [capabilities.agents] keys). `agents` is required and ordered — it becomes the
# team's agent_priority; `capabilities`/`strategy` are optional overrides (an
# explicit --strategy flag still beats the profile); a goal may belong to at
# most one team. Inspect with `syncmill team list` / `team show <name>`.
# `team save <name> -a codex -a claude [-s compete -g backend -c codex=python]`
# writes/replaces a [teams.<name>] table in THIS file comment-preservingly
# (tomlkit round-trip), as does the dashboard TEAM pane (`t` key); and
# `team use <name>` persists a top-level `default_team` key here that
# run/board run auto-apply when no --team is passed (`team use --clear` removes):
# default_team = "python-team"
# [teams.python-team]
# agents = ["codex", "claude"]        # ordered subset -> the team's lineup
# strategy = "compete"                # optional; omit to inherit default_strategy
# goals = ["backend", "api"]          # board goals this team owns
# [teams.python-team.capabilities]    # optional; omit to keep [capabilities.agents]
# codex = ["python"]
#
# [teams.rust-team]
# agents = ["kimi-code", "codex"]
# goals = ["porting"]
