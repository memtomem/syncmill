# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
preflight-dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Local project config — copy syncmill.toml.example to syncmill.toml. Never
# commit a real one: config discovery is cwd-relative, so a repo-root
# syncmill.toml would leak into the (cwd=repo-root) test suite.
/syncmill.toml

# dev-trio reviewer logs/manifests (ask-codex.sh writes here) — local artifacts.
.dev-trio/

# macOS Finder metadata — never ship.
.DS_Store

# memtomem local artifacts (ADR-0011 project_local tier)
.memtomem/*.local/
.memtomem/.staging/
