{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toolgraph.dev/contracts/control-preflight.schema.json",
  "title": "toolgraph control-plan preflight result",
  "description": "One advisory, collision-safe graph-state evaluation of a body-free control plan. Enforcement remains the consumer's responsibility.",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "kind", "run_id", "created_at", "mode", "profile", "plan_digest", "graph_state", "decision", "evaluations", "findings"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "toolgraph.control-preflight"},
    "run_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "mode": {"const": "advisory"},
    "profile": {"enum": ["strict", "review", "explore"]},
    "plan_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "graph_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instance_id", "generation"],
      "properties": {
        "instance_id": {"type": "string", "minLength": 1},
        "generation": {"type": "integer", "minimum": 0}
      }
    },
    "decision": {"enum": ["advisory_allow", "advisory_warn"]},
    "evaluations": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/evaluation"}
    },
    "findings": {
      "type": "array",
      "items": {"$ref": "#/$defs/finding"}
    }
  },
  "$defs": {
    "qualifiedToolKey": {"type": "string", "pattern": "^[^:\\s]+::[^:\\s]+$"},
    "evaluation": {
      "type": "object",
      "additionalProperties": true,
      "required": ["principal", "agent_found", "eligible", "rejected"],
      "properties": {
        "principal": {"type": "string", "minLength": 1},
        "agent_found": {"type": "boolean"},
        "eligible": {"type": "array", "items": {"$ref": "#/$defs/qualifiedToolKey"}},
        "rejected": {"type": "array", "items": {"type": "object"}}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": true,
      "required": ["code"],
      "properties": {
        "code": {
          "enum": [
            "START_NODE_COUNT",
            "END_NODE_COUNT",
            "UNKNOWN_NODE_REFERENCE",
            "UNREACHABLE_NODE",
            "NO_TERMINAL_PATH",
            "CONTROL_CYCLE_UNSUPPORTED",
            "MODEL_FANOUT_UNBOUNDED",
            "CALL_BOUND_TOO_LOW",
            "PARALLEL_BOUND_TOO_LOW"
          ]
        },
        "nodes": {"type": "array", "items": {"type": "string"}},
        "edges": {"type": "array", "items": {"type": "integer", "minimum": 0}},
        "declared": {"type": "integer", "minimum": 0},
        "required": {"type": "integer", "minimum": 0}
      }
    }
  }
}
